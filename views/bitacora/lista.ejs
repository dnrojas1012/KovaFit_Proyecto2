<%- include('../partials/header') %>
<h1>Bitácora de seguridad</h1>
<form method="get" action="/bitacora" class="filtros">
  <label for="evento">Filtrar por evento</label>
  <select id="evento" name="evento">
    <option value="">Todos</option>
    <% EVENTOS.forEach(function (e) { %><option <%= e === evento ? 'selected' : '' %>><%= e %></option><% }) %>
  </select>
  <button type="submit" class="boton">Filtrar</button>
</form>
<p class="nota">Últimos <%= registros.length %> eventos.</p>
<div class="tabla-scroll">
<table>
  <thead><tr><th>Fecha y hora</th><th>Evento</th><th>Usuario</th><th>IP</th><th>Ruta</th><th>Detalle</th></tr></thead>
  <tbody>
  <% registros.forEach(function (r) { %>
    <tr>
      <td><%= new Date(r.fecha).toLocaleString('es-CR', { timeZone: 'America/Costa_Rica', dateStyle: 'short', timeStyle: 'medium' }) %></td>
      <td><span class="etiqueta <%= /DENEGADO|FALLIDO|RECHAZADO/.test(r.evento) ? 'roja' : '' %>"><%= r.evento %></span></td>
      <td><%= r.username || '—' %></td>
      <td><%= r.ip %></td>
      <td><%= r.ruta %></td>
      <td><%= r.detalle %></td>
    </tr>
  <% }) %>
  <% if (!registros.length) { %><tr><td colspan="6" class="nota">No hay eventos.</td></tr><% } %>
  </tbody>
</table>
</div>
<%- include('../partials/footer') %>