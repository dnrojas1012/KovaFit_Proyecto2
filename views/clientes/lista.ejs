<%- include('../partials/header') %>
<div class="encabezado">
  <h1>Clientes</h1>
  <% if (usuario.permisos.includes('CREAR')) { %><a class="boton" href="/clientes/nuevo">+ Nuevo cliente</a><% } %>
</div>
<%- include('../partials/mensaje') %>
<% if (!sensibles) { %>
  <p class="alerta info">Su rol es de solo lectura: la cédula aparece enmascarada y los datos de contacto están ocultos.</p>
<% } %>
<form method="get" action="/clientes" class="filtros">
  <label for="q">Buscar por nombre o cédula</label>
  <input id="q" name="q" maxlength="50" value="<%= q %>">
  <button type="submit" class="boton">Buscar</button>
</form>
<% if (q) { %><p>Resultados para: <strong><%= q %></strong> (<%= clientes.length %>)</p><% } %>
<div class="tabla-scroll">
<table>
  <thead><tr>
    <th>Nombre</th><th>Cédula</th>
    <% if (sensibles) { %><th>Teléfono</th><th>Contacto de emergencia</th><% } %>
    <th>Membresía vence</th>
    <% if (sensibles) { %><th>Acciones</th><% } %>
  </tr></thead>
  <tbody>
  <% clientes.forEach(function (c) { %>
    <tr>
      <td><%= c.nombre %></td>
      <td><%= c.cedula %></td>
      <% if (sensibles) { %><td><%= c.telefono %></td><td><%= c.emergencia %></td><% } %>
      <td><%= c.vence ? c.vence.split('-').reverse().join('/') : 'Sin membresía' %></td>
      <% if (sensibles) { %>
      <td class="acciones">
        <a href="/clientes/<%= c.id %>/editar">Editar</a>
        <% if (usuario.permisos.includes('CREAR')) { %><a href="/membresias/nueva?cliente_id=<%= c.id %>">Vender membresía</a><% } %>
        <% if (usuario.permisos.includes('BORRAR')) { %>
        <form method="post" action="/clientes/<%= c.id %>/eliminar" class="en-linea" data-confirmar="¿Borrar a este cliente?">
          <%- include('../partials/csrf') %>
          <button type="submit" class="enlace peligro">Borrar</button>
        </form>
        <% } %>
      </td>
      <% } %>
    </tr>
  <% }) %>
  <% if (!clientes.length) { %><tr><td colspan="6" class="nota">No hay clientes para mostrar.</td></tr><% } %>
  </tbody>
</table>
</div>
<%- include('../partials/footer') %>