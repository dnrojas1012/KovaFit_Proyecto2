<%- include('../partials/header') %>
<h1><%= titulo %></h1>
<form method="post" action="<%= typeof id !== 'undefined' && id ? '/usuarios/' + id : '/usuarios' %>" class="tarjeta formulario">
  <%- include('../partials/csrf') %>
  <%- include('../partials/errores') %>
  <label for="username">Usuario (para iniciar sesión)</label>
  <input id="username" name="username" maxlength="30" required value="<%= datos.username || '' %>" autocomplete="off">
  <label for="identificacion">Identificación (cédula)</label>
  <input id="identificacion" name="identificacion" maxlength="20" required value="<%= datos.identificacion || '' %>" placeholder="2-0701-0101">
  <label for="nombre">Nombre completo</label>
  <input id="nombre" name="nombre" maxlength="100" required value="<%= datos.nombre || '' %>">
  <label for="correo">Correo</label>
  <input id="correo" name="correo" type="email" maxlength="120" required value="<%= datos.correo || '' %>">
  <label for="rol_id">Rol</label>
  <select id="rol_id" name="rol_id" required>
    <option value="">Seleccione…</option>
    <% roles.forEach(function (r) { %><option value="<%= r.id %>" <%= Number(datos.rol_id) === r.id ? 'selected' : '' %>><%= r.nombre %></option><% }) %>
  </select>
  <label for="password">Contraseña<%= typeof id !== 'undefined' && id ? ' (déjela vacía para no cambiarla)' : '' %></label>
  <input id="password" name="password" type="password" maxlength="128" autocomplete="new-password" <%= typeof id !== 'undefined' && id ? '' : 'required' %>>
  <p class="nota">Mínimo 10 caracteres, con letras y números. Se guarda cifrada con Argon2id.</p>
  <label class="check"><input type="checkbox" name="activo" <%= datos.activo ? 'checked' : '' %>> Usuario activo</label>
  <div class="atajos"><button type="submit" class="boton">Guardar</button><a class="boton secundario" href="/usuarios">Cancelar</a></div>
</form>
<%- include('../partials/footer') %>