<%- include('../partials/header') %>
<h1><%= titulo %></h1>
<form method="post" action="/membresias/<%= m.id %>/renovar" class="tarjeta formulario">
  <%- include('../partials/csrf') %>
  <p>Cliente: <strong><%= m.cliente.nombre %></strong><br>
     Vence: <strong><%= vence %></strong> · La renovación empezará el <strong><%= inicio %></strong>.</p>
  <%- include('../partials/errores') %>
  <label for="plan">Plan</label>
  <select id="plan" name="plan" required>
    <% [['MENSUAL','Mensual'],['TRIMESTRAL','Trimestral'],['ANUAL','Anual']].forEach(function (p) { %>
      <option value="<%= p[0] %>" <%= datos.plan === p[0] ? 'selected' : '' %>><%= p[1] %></option>
    <% }) %>
  </select>
  <label for="monto">Monto pagado (₡)</label>
  <input id="monto" name="monto" inputmode="decimal" required value="<%= datos.monto %>">
  <div class="atajos"><button type="submit" class="boton">Renovar</button><a class="boton secundario" href="/membresias">Cancelar</a></div>
</form>
<%- include('../partials/footer') %>