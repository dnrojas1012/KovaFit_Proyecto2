<%- include('../partials/header') %>
<h1><%= titulo %></h1>
<form method="post" action="<%= id ? '/membresias/' + id : '/membresias' %>" class="tarjeta formulario">
  <%- include('../partials/csrf') %>
  <%- include('../partials/errores') %>
  <label for="cliente_id">Cliente</label>
  <select id="cliente_id" name="cliente_id" required <%= id ? 'disabled' : '' %>>
    <option value="">Seleccione un cliente...</option>
    <% clientes.forEach(function (c) { %>
      <option value="<%= c.id %>" <%= Number(datos.cliente_id) === c.id ? 'selected' : '' %>><%= c.nombre %></option>
    <% }) %>
  </select>
  <label for="plan">Plan</label>
  <select id="plan" name="plan" required>
    <% [['MENSUAL','Mensual (1 mes)'],['TRIMESTRAL','Trimestral (3 meses)'],['ANUAL','Anual (12 meses)']].forEach(function (p) { %>
      <option value="<%= p[0] %>" <%= datos.plan === p[0] ? 'selected' : '' %>><%= p[1] %></option>
    <% }) %>
  </select>
  <label for="fecha_inicio">Fecha de inicio</label>
  <input id="fecha_inicio" name="fecha_inicio" type="date" required value="<%= datos.fecha_inicio %>">
  <label for="monto">Monto pagado (₡)</label>
  <input id="monto" name="monto" inputmode="decimal" required value="<%= datos.monto %>" placeholder="25000">
  <p class="alerta info">El vencimiento se calcula solo: inicio + duración del plan − 1 día. Ej.: mensual del 01/11 vence el 30/11.</p>
  <div class="atajos"><button type="submit" class="boton">Guardar</button><a class="boton secundario" href="/membresias">Cancelar</a></div>
</form>
<%- include('../partials/footer') %>