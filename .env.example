# Copie este archivo como .env y cambie los valores. El .env nunca se sube a GitHub.
PORT=3000
# postgresql://USUARIO:CLAVE@HOST:PUERTO/BASE
DATABASE_URL=postgresql://postgres:SU_CLAVE@localhost:5432/kova_fit
# true solo si la base en la nube exige SSL
DB_SSL=false
# Cadena larga y aleatoria (mínimo 32 caracteres)
SESSION_SECRET=cambie-esto-por-una-cadena-larga-y-aleatoria
SESSION_TIMEOUT_SECONDS=60
# development en su PC, production al publicar (activa cookie Secure y HSTS)
NODE_ENV=development